# Remote debugging against a Dify instance: copy to .env, then `python -m main`.
# Get the URL and key from Dify → Plugins → "Debug" (the bug icon).
INSTALL_METHOD=remote
REMOTE_INSTALL_URL=debug.dify.ai:5003
REMOTE_INSTALL_KEY=********-****-****-****-************

# Optional: run the integration tests against a real Busabase server
# (an open local server needs no key: `npx busabase server --data /tmp/bb`).
# BUSABASE_TEST_BASE_URL=http://127.0.0.1:15419
# BUSABASE_TEST_API_KEY=
# BUSABASE_TEST_SPACE_ID=
